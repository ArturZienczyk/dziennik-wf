{
  "name": "Dziennik WF",
  "short_name": "Dziennik WF",
  "description": "Frekwencja, pomiary i oceny WF — działa offline, dane tylko na urządzeniu.",
  "lang": "pl",
  "start_url": "./dziennik_wf.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F4F1EA",
  "theme_color": "#33415C",
  "share_target": {
    "action": "./dziennik_wf.html?udostepniona-kopia",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "kopia", "accept": ["text/plain", "application/json", ".txt", ".json"] }]
    }
  },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
