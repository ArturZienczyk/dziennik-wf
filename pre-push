#!/bin/sh
# pre-push — zapadka bramek dziennika WF (wzor: D:/Projects/design/tools/pre-push.sample).
#
# INSTALACJA (raz, po klonie repo):
#   cp pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# DWA KROKI, w tej kolejnosci:
#   [1] odcisk.py --check  — czy wejscia bramek (kod .html/.js/.py) sa identyczne jak przy
#       ostatnim ZIELONYM biegu. Tak -> SKIP, push idzie od razu. Typowy przypadek: odpalasz
#       sprawdz_wszystko.py recznie przy pracy, potem pushujesz — push nie powtarza 75 s,
#       ktore wlasnie zaplacilies. Zmiana samego README nie uniewaznia odcisku.
#   [2] sprawdz_wszystko.py -j 1 — caly zestaw bramek PO KOLEI. Zielony -> odcisk.py --record.
#       Czerwony -> push wstrzymany, nic sie nie zapisuje (FAIL nigdy nie jest cache'owany).
#
# DLACZEGO -j 1, skoro runner umie rownolegle: kanon D:/Projects/konkurs-naukowy/docs/
# KANON-straznicy-e2e.md ("Zakaz rownoleglosci") — rownolegle Chromium spowalnia rAF i wraca
# jako falszywy FAIL, kolizje portow staja sie nieodroznialne od defektow, a log ma mowic,
# ktory straznik padl PIERWSZY. Rownoleglosc zostaje do biegu RECZNEGO (tam falszywy alarm
# kosztuje powtorzenie, nie zablokowany push). Dzwignia czasu w hooku to odcisk, nie -j.
#
# DLACZEGO odcisk zamiast `git diff` po sciezkach: bramka na diffie opiera sie na indukcji
# "to, co juz na remote, bylo zielone", ktora peka po cichu przy jednym --no-verify.
# Odcisk porownuje stan drzewa TERAZ z ostatnim faktycznie zielonym biegiem.
# Ledger: D:/Projects/docs/ledger/2026-08-25_build-skip-odcisk-wejsc-bkk.md
#
# Cofniecie bramki = swiadoma edycja testu + commit z "dlaczego", nie kasowanie hooka.
ZERO="0000000000000000000000000000000000000000"
sprawdzone=0

while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue        # kasowanie galezi — nic do sprawdzania
  [ "$sprawdzone" = "1" ] && continue           # jeden bieg wystarczy na caly push

  if py -3.14 odcisk.py --check; then
    echo "[pre-push] SKIP: kod bez zmian od ostatniego zielonego biegu bramek."
    sprawdzone=1
    continue
  fi

  echo "[pre-push] kod dziennika zmieniony -> wszystkie bramki po kolei (~3-4 min)..."
  if py -3.14 sprawdz_wszystko.py -j 1; then
    py -3.14 odcisk.py --record
    echo "[pre-push] zielono — odcisk zapisany, nastepny push bez zmian w kodzie pojdzie od razu."
    sprawdzone=1
  else
    echo "[pre-push] BLOKADA: bramka czerwona. Push wstrzymany." >&2
    echo "[pre-push] Pojedynczy test: py -3.14 sprawdz_wszystko.py -k <fragment nazwy>" >&2
    exit 1
  fi
done
exit 0
